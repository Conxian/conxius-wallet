{
  "name": "conxius-wallet",
  "private": true,
  "version": "1.9.5",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "overrides": {
    "protobufjs": ">=7.6.4",
    "lodash": ">=4.18.1",
    "ws": ">=8.21.0",
    "undici": "7.29.0",
    "form-data": ">=4.0.6",
    "@tbd54566975/dwn-sdk-js@0.5.1>ajv": "8.18.0",
    "@babel/core": "7.29.7",
    "ajv@8.12.0": "8.18.0",
    "uuid": "11.1.1",
    "tar": "7.5.21",
    "valibot": "1.4.2",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:typescript-compat && pnpm run typecheck:ts7 && vite build",
    "preview": "vite preview",
    "android:build": "pnpm run build && pnpm cap sync && pnpm cap open android",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bench:silent-payments": "node scripts/bench-silent-payments.mjs",
    "prepare": "husky",
    "lint": "pnpm run check:typescript-compat && eslint .",
    "typecheck": "pnpm run check:typescript-compat && pnpm run typecheck:dual",
    "check:typescript-toolchain": "node scripts/ci/verify_typescript_dual_toolchain.mjs",
    "typecheck:ts6": "tsc6 --project tsconfig.ts6.json --noEmit",
    "typecheck:ts7": "tsc --project tsconfig.ts7.json --noEmit",
    "typecheck:dual": "pnpm run check:typescript-toolchain && pnpm run typecheck:ts6 && pnpm run typecheck:ts7",
    "verify": "bash scripts/ci/verify_local.sh",
    "check:typescript-compat": "node scripts/ci/check_typescript_compatibility.mjs",
    "check:release-version": "node scripts/ci/check_release_version.mjs",
    "check:workflow-pins": "python3 scripts/ci/check_workflow_pins.py",
    "check:android-security": "bash scripts/ci/validate_android_security.sh",
    "check:android-toolchain": "node scripts/ci/check_android_toolchain_matrix.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.17.1",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@stacks/auth": "^7.6.0",
    "@stacks/common": "^7.6.0",
    "@stacks/network": "^7.6.0",
    "@stacks/transactions": "^7.6.0",
    "@testing-library/dom": "^10.4.1",
    "@web5/api": "^0.12.0",
    "@wormhole-foundation/sdk": "^6.1.5",
    "@wormhole-foundation/sdk-evm": "^6.1.5",
    "@wormhole-foundation/sdk-solana": "^6.1.5",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "algosdk": "^3.6.0",
    "bech32": "^2.0.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "buffer": "^6.0.3",
    "ecpair": "^3.0.1",
    "generator-function": "^2.0.1",
    "is-generator-function": "^1.1.2",
    "light-bolt11-decoder": "^3.0.0",
    "liquidjs-lib": "^6.0.2-liquid.38",
    "lucide-react": "^1.32.0",
    "node-fetch": "^3.3.2",
    "payjoin-client": "^1.0.1",
    "qrcode": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tiny-secp256k1": "^2.2.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^7.3.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.11",
    "@wormhole-foundation/sdk-definitions-ntt": "^8.0.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "semver": "7.8.5",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run"
    ]
  }
}
